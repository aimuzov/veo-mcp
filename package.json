{
	"name": "veo-mcp",
	"version": "0.1.0",
	"private": true,
	"description": "Minimal MCP server for Google Veo video generation through the Gemini API: text-to-video and image-to-video, saves MP4 files to disk",
	"license": "MIT",
	"author": "Aleksey Imuzov",
	"repository": "github:aimuzov/veo-mcp",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"start": "node src/index.ts",
		"test": "node --test 'src/**/*.test.ts'",
		"typecheck": "tsc",
		"format": "oxlint --fix && prettier --write .",
		"format:check": "prettier --check .",
		"lint": "oxlint --deny-warnings"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "1.32.1",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@aimuzov-projects/infra-site-kit": "github:aimuzov-projects/infra-site-kit#v1.14.1",
		"@types/node": "26.6.5",
		"oxlint": "1.87.0",
		"prettier": "3.9.9",
		"typescript": "6.0.3"
	}
}
